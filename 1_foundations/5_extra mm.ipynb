       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Barbell bench press</span> <span style=\"font-weight: bold\">(</span>or DB bench if shoulders prefer<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> @ ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">75</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">82</span>% 1RM | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span> min  \n",
       "  <span style=\"font-style: italic\">Example</span>: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">170</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">185</span> lb <span style=\"font-weight: bold\">(</span>if 1RM bench = <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">225</span><span style=\"font-weight: bold\">)</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Lat pulldown</span> <span style=\"font-weight: bold\">(</span>neutral or medium grip<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span> @ ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">65</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">75</span>% 1RM | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">120</span> sec  \n",
       "  <span style=\"font-style: italic\">Example</span>: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">115</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">135</span> lb <span style=\"font-weight: bold\">(</span>if 1RM pulldown = <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">180</span><span style=\"font-weight: bold\">)</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Romanian deadlift (barbell or DB)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">10</span> @ ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">70</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">80</span>% <span style=\"font-weight: bold\">(</span>of your RDL 1RM or equivalent RPE<span style=\"font-weight: bold\">)</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> min  \n",
       "  <span style=\"font-style: italic\">Example proxy</span>: ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">225</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">275</span> lb for many lifters <span style=\"font-weight: bold\">(</span>choose load for RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">)</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">5</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Chest-supported row machine</span> <span style=\"font-weight: bold\">(</span>or chest-supported DB row<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec  \n",
       "  <span style=\"font-style: italic\">Load</span>: choose a weight that leaves ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">1</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> reps in reserve on each set.\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Lateral raise (DB or cable)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">20</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">9</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">60</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">75</span> sec\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Standing calf raise (machine)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span> with a controlled <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">1</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> sec pause at the stretch | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">60</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec  \n",
       "  <span style=\"font-style: italic\">Load</span>: RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">9</span>.\n",
       "\n",
       "<span style=\"font-weight: bold\">Optional time-saver</span>: Superset #<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span> and #<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span>.\n",
       "\n",
       "---\n",
       "\n",
       "<span style=\"font-weight: bold; text-decoration: underline\">Workout B (Full Body)</span>\n",
       "<span style=\"font-style: italic\">Primary emphasis: hinge + vertical press + horizontal row + unilateral legs</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">1</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Deadlift pattern (choose one)</span>  \n",
       "- <span style=\"font-weight: bold\">Trap-bar deadlift</span> <span style=\"font-weight: bold\">(</span>often most joint-friendly<span style=\"font-weight: bold\">)</span> or <span style=\"font-weight: bold\">Conventional deadlift</span>  \n",
       "  <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">5</span> @ ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">82</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">88</span>% 1RM <span style=\"font-weight: bold\">(</span>RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">9</span><span style=\"font-weight: bold\">)</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span>+ min  \n",
       "  <span style=\"font-style: italic\">Example</span>: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">300</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">320</span> lb <span style=\"font-weight: bold\">(</span>if 1RM deadlift = <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">365</span><span style=\"font-weight: bold\">)</span>  \n",
       "  <span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\">If fatigue/soreness is high: do </span><span style=\"color: #7fbfbf; text-decoration-color: #7fbfbf; font-weight: bold\">4</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\">–</span><span style=\"color: #7fbfbf; text-decoration-color: #7fbfbf; font-weight: bold\">5</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\"> sets of </span><span style=\"color: #7fbfbf; text-decoration-color: #7fbfbf; font-weight: bold\">3</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\"> @ RPE ~</span><span style=\"color: #7fbfbf; text-decoration-color: #7fbfbf; font-weight: bold\">7</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\"> </span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f; font-weight: bold\">(</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\">crisp reps</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f; font-weight: bold\">)</span><span style=\"color: #7f7f7f; text-decoration-color: #7f7f7f\">.</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Overhead press</span> <span style=\"font-weight: bold\">(</span>barbell or DB<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">5</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> @ ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">70</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">80</span>% 1RM | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> min  \n",
       "  <span style=\"font-style: italic\">Example</span>: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">100</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">115</span> lb <span style=\"font-weight: bold\">(</span>if 1RM OHP = <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">145</span><span style=\"font-weight: bold\">)</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">One-arm DB row</span> <span style=\"font-weight: bold\">(</span>or seated cable row if low back prefers<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span><span style=\"font-weight: bold\"> each side</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec  \n",
       "  <span style=\"font-style: italic\">Load</span>: choose a DB that leaves ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">1</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> reps in reserve.\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Unilateral leg work (choose one)</span>  \n",
       "- <span style=\"font-weight: bold\">Bulgarian split squat (DB)</span> or <span style=\"font-weight: bold\">Leg press (single-leg or standard)</span>  \n",
       "  - Split squat: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span><span style=\"font-weight: bold\"> each leg</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec  \n",
       "  - Leg press: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">10</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">15</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span> min  \n",
       "  <span style=\"font-style: italic\">Example leg press</span>: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">325</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">375</span> lb for sets of <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">10</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">15</span> <span style=\"font-weight: bold\">(</span>if 1RM leg press = <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">500</span>, ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">65</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">75</span>%<span style=\"font-weight: bold\">)</span>\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">5</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Incline DB press</span> <span style=\"font-weight: bold\">(</span>or machine incline press<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">12</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec  \n",
       "  <span style=\"font-style: italic\">Load</span>: pick DBs you can control without shoulder irritation.\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Hamstring curl machine</span> <span style=\"font-weight: bold\">(</span>seated preferred for many<span style=\"font-weight: bold\">)</span>  \n",
       "- <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">10</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">15</span> @ RPE <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">9</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">60</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Cable Pallof press</span> <span style=\"font-weight: bold\">(</span>anti-rotation<span style=\"font-weight: bold\">)</span> or <span style=\"font-weight: bold\">loaded carry</span>  \n",
       "- Pallof: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">10</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">15</span><span style=\"font-weight: bold\">/side</span> <span style=\"font-weight: bold\">(</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span>-sec hold<span style=\"font-weight: bold\">)</span> | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">45</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">60</span> sec  \n",
       "- Farmer carry: <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span><span style=\"font-weight: bold\"> x </span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">20</span><span style=\"font-weight: bold\">–</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">40</span><span style=\"font-weight: bold\"> m</span> with challenging DB/KBs | Rest <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">60</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">90</span> sec\n",
       "\n",
       "---\n",
       "\n",
       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">50</span><span style=\"font-weight: bold\">+ execution notes (to keep results high and joints happy)</span>\n",
       "- Prioritize <span style=\"font-weight: bold\">controlled eccentrics</span> <span style=\"font-weight: bold\">(</span><span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">2</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">3</span> sec down<span style=\"font-weight: bold\">)</span> on most lifts; avoid grinders weekly.\n",
       "- If a joint complains: swap to <span style=\"font-weight: bold\">safety-bar squat, trap-bar deadlift, DB presses, chest-supported rows, machines</span> \n",
       "<span style=\"font-weight: bold\">(</span>stimulus stays high with less irritation<span style=\"font-weight: bold\">)</span>.\n",
       "- Every <span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">8</span> weeks, take a <span style=\"font-weight: bold\">deload</span> week: cut sets ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">30</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">40</span>% and keep RPE ~<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">6</span>–<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">7</span>.\n",
       "</pre>\n"
      ],
      "text/plain": [
       "\u001b[1;36m2\u001b[0m\u001b[1m-Day Full-Body Plan \u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m50\u001b[0m\u001b[1m+, experienced\u001b[0m\u001b[1m)\u001b[0m\u001b[1m — Muscle Maintenance \u001b[0m\u001b[1m(\u001b[0m\u001b[1mprimary\u001b[0m\u001b[1m)\u001b[0m\u001b[1m + Hypertrophy \u001b[0m\u001b[1m(\u001b[0m\u001b[1msecondary\u001b[0m\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1mSchedule\u001b[0m: \u001b[1;36m2\u001b[0m non-consecutive days \u001b[1m(\u001b[0me.g., Mon = Workout A, Thu = Workout B\u001b[1m)\u001b[0m  \n",
       "\u001b[1mSession length\u001b[0m: ~\u001b[1;36m60\u001b[0m–\u001b[1;36m90\u001b[0m min including warm-up  \n",
       "\u001b[1mEffort target\u001b[0m: most work sets at \u001b[1mRPE \u001b[0m\u001b[1;36m7\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m9\u001b[0m \u001b[1m(\u001b[0mleave ~\u001b[1;36m1\u001b[0m–\u001b[1;36m3\u001b[0m reps in reserve\u001b[1m)\u001b[0m  \n",
       "\u001b[1mRest\u001b[0m: big compounds \u001b[1;36m2\u001b[0m–\u001b[1;36m3\u001b[0m min; accessories \u001b[1;36m60\u001b[0m–\u001b[1;36m90\u001b[0m sec  \n",
       "\u001b[1mWarm-up \u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m\u001b[1m min\u001b[0m\u001b[1m)\u001b[0m: easy cardio + hips/shoulders mobility, then \u001b[1;36m2\u001b[0m–\u001b[1;36m4\u001b[0m ramp sets for the first \u001b[1;36m1\u001b[0m–\u001b[1;36m2\u001b[0m lifts.\n",
       "\n",
       "\u001b[1mHow to choose the weight\u001b[0m\n",
       "- Use either:\n",
       "  - \u001b[1m%1RM\u001b[0m guide \u001b[1m(\u001b[0mbelow\u001b[1m)\u001b[0m, or\n",
       "  - pick a load that lands you in the rep range at \u001b[1mRPE \u001b[0m\u001b[1;36m7\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m9\u001b[0m.\n",
       "- \u001b[1mProgression \u001b[0m\u001b[1m(\u001b[0m\u001b[1mdouble progression\u001b[0m\u001b[1m)\u001b[0m: when you hit the \u001b[4mtop\u001b[0m of the rep range for all sets at the target RPE, add load \n",
       "next time \u001b[1m(\u001b[0mupper body +\u001b[1;36m2.5\u001b[0m–\u001b[1;36m5\u001b[0m lb; lower body +\u001b[1;36m5\u001b[0m–\u001b[1;36m10\u001b[0m lb; machines +\u001b[1;36m1\u001b[0m plate/small increment\u001b[1m)\u001b[0m.\n",
       "\n",
       "\u001b[3mExample loads\u001b[0m below assume these \u001b[4millustrative\u001b[0m 1RMs for an experienced lifter \u001b[1m(\u001b[0madjust to yours\u001b[1m)\u001b[0m:  \n",
       "Squat \u001b[1;36m300\u001b[0m lb, Bench \u001b[1;36m225\u001b[0m, Deadlift \u001b[1;36m365\u001b[0m, OHP \u001b[1;36m145\u001b[0m, Row \u001b[1;36m205\u001b[0m, Lat Pulldown \u001b[1;36m180\u001b[0m, Leg Press \u001b[1;36m500\u001b[0m.\n",
       "\n",
       "---\n",
       "\n",
       "\u001b[1;4mWorkout A \u001b[0m\u001b[1;4m(\u001b[0m\u001b[1;4mFull Body\u001b[0m\u001b[1;4m)\u001b[0m\n",
       "\u001b[3mPrimary emphasis: squat + horizontal press + vertical pull\u001b[0m\n",
       "\n",
       "\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m \u001b[1mSquat pattern \u001b[0m\u001b[1m(\u001b[0m\u001b[1mchoose one\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1mHigh-bar back squat\u001b[0m or \u001b[1mSafety-bar squat\u001b[0m  \n",
       "  \u001b[1;36m3\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m4\u001b[0m\u001b[1m sets x \u001b[0m\u001b[1;36m5\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m6\u001b[0m\u001b[1m reps\u001b[0m @ ~\u001b[1;36m80\u001b[0m–\u001b[1;36m85\u001b[0m% 1RM \u001b[1m(\u001b[0mRPE \u001b[1;36m7\u001b[0m–\u001b[1;36m9\u001b[0m\u001b[1m)\u001b[0m | Rest \u001b[1;36m2\u001b[0m–\u001b[1;36m3\u001b[0m min  \n",
       "  \u001b[3mExample\u001b[0m: \u001b[1;36m240\u001b[0m–\u001b[1;36m255\u001b[0m lb \u001b[1m(\u001b[0mif 1RM squat = \u001b[1;36m300\u001b[0m\u001b[1m)\u001b[0m  \n",
       "  \u001b[2mJoint-friendlier swap: Hack squat or Leg press if needed.\u001b[0m\n",
       "\n",
       "\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m \u001b[1mBarbell bench press\u001b[0m \u001b[1m(\u001b[0mor DB bench if shoulders prefer\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m3\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m4\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m6\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m8\u001b[0m @ ~\u001b[1;36m75\u001b[0m–\u001b[1;36m82\u001b[0m% 1RM | Rest \u001b[1;36m2\u001b[0m–\u001b[1;36m3\u001b[0m min  \n",
       "  \u001b[3mExample\u001b[0m: \u001b[1;36m170\u001b[0m–\u001b[1;36m185\u001b[0m lb \u001b[1m(\u001b[0mif 1RM bench = \u001b[1;36m225\u001b[0m\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1;36m3\u001b[0m\u001b[1m)\u001b[0m \u001b[1mLat pulldown\u001b[0m \u001b[1m(\u001b[0mneutral or medium grip\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m @ ~\u001b[1;36m65\u001b[0m–\u001b[1;36m75\u001b[0m% 1RM | Rest \u001b[1;36m90\u001b[0m–\u001b[1;36m120\u001b[0m sec  \n",
       "  \u001b[3mExample\u001b[0m: \u001b[1;36m115\u001b[0m–\u001b[1;36m135\u001b[0m lb \u001b[1m(\u001b[0mif 1RM pulldown = \u001b[1;36m180\u001b[0m\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1;36m4\u001b[0m\u001b[1m)\u001b[0m \u001b[1mRomanian deadlift \u001b[0m\u001b[1m(\u001b[0m\u001b[1mbarbell or DB\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m6\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m10\u001b[0m @ ~\u001b[1;36m70\u001b[0m–\u001b[1;36m80\u001b[0m% \u001b[1m(\u001b[0mof your RDL 1RM or equivalent RPE\u001b[1m)\u001b[0m | Rest \u001b[1;36m2\u001b[0m min  \n",
       "  \u001b[3mExample proxy\u001b[0m: ~\u001b[1;36m225\u001b[0m–\u001b[1;36m275\u001b[0m lb for many lifters \u001b[1m(\u001b[0mchoose load for RPE \u001b[1;36m7\u001b[0m–\u001b[1;36m8\u001b[0m\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1;36m5\u001b[0m\u001b[1m)\u001b[0m \u001b[1mChest-supported row machine\u001b[0m \u001b[1m(\u001b[0mor chest-supported DB row\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m @ RPE \u001b[1;36m8\u001b[0m | Rest \u001b[1;36m90\u001b[0m sec  \n",
       "  \u001b[3mLoad\u001b[0m: choose a weight that leaves ~\u001b[1;36m1\u001b[0m–\u001b[1;36m2\u001b[0m reps in reserve on each set.\n",
       "\n",
       "\u001b[1;36m6\u001b[0m\u001b[1m)\u001b[0m \u001b[1mLateral raise \u001b[0m\u001b[1m(\u001b[0m\u001b[1mDB or cable\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m12\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m20\u001b[0m @ RPE \u001b[1;36m8\u001b[0m–\u001b[1;36m9\u001b[0m | Rest \u001b[1;36m60\u001b[0m–\u001b[1;36m75\u001b[0m sec\n",
       "\n",
       "\u001b[1;36m7\u001b[0m\u001b[1m)\u001b[0m \u001b[1mStanding calf raise \u001b[0m\u001b[1m(\u001b[0m\u001b[1mmachine\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m with a controlled \u001b[1;36m1\u001b[0m–\u001b[1;36m2\u001b[0m sec pause at the stretch | Rest \u001b[1;36m60\u001b[0m–\u001b[1;36m90\u001b[0m sec  \n",
       "  \u001b[3mLoad\u001b[0m: RPE \u001b[1;36m8\u001b[0m–\u001b[1;36m9\u001b[0m.\n",
       "\n",
       "\u001b[1mOptional time-saver\u001b[0m: Superset #\u001b[1;36m6\u001b[0m and #\u001b[1;36m7\u001b[0m.\n",
       "\n",
       "---\n",
       "\n",
       "\u001b[1;4mWorkout B \u001b[0m\u001b[1;4m(\u001b[0m\u001b[1;4mFull Body\u001b[0m\u001b[1;4m)\u001b[0m\n",
       "\u001b[3mPrimary emphasis: hinge + vertical press + horizontal row + unilateral legs\u001b[0m\n",
       "\n",
       "\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m \u001b[1mDeadlift pattern \u001b[0m\u001b[1m(\u001b[0m\u001b[1mchoose one\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1mTrap-bar deadlift\u001b[0m \u001b[1m(\u001b[0moften most joint-friendly\u001b[1m)\u001b[0m or \u001b[1mConventional deadlift\u001b[0m  \n",
       "  \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m5\u001b[0m @ ~\u001b[1;36m82\u001b[0m–\u001b[1;36m88\u001b[0m% 1RM \u001b[1m(\u001b[0mRPE \u001b[1;36m7\u001b[0m–\u001b[1;36m9\u001b[0m\u001b[1m)\u001b[0m | Rest \u001b[1;36m2\u001b[0m–\u001b[1;36m3\u001b[0m+ min  \n",
       "  \u001b[3mExample\u001b[0m: \u001b[1;36m300\u001b[0m–\u001b[1;36m320\u001b[0m lb \u001b[1m(\u001b[0mif 1RM deadlift = \u001b[1;36m365\u001b[0m\u001b[1m)\u001b[0m  \n",
       "  \u001b[2mIf fatigue/soreness is high: do \u001b[0m\u001b[1;2;36m4\u001b[0m\u001b[2m–\u001b[0m\u001b[1;2;36m5\u001b[0m\u001b[2m sets of \u001b[0m\u001b[1;2;36m3\u001b[0m\u001b[2m @ RPE ~\u001b[0m\u001b[1;2;36m7\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mcrisp reps\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\n",
       "\n",
       "\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m \u001b[1mOverhead press\u001b[0m \u001b[1m(\u001b[0mbarbell or DB\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m5\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m8\u001b[0m @ ~\u001b[1;36m70\u001b[0m–\u001b[1;36m80\u001b[0m% 1RM | Rest \u001b[1;36m2\u001b[0m min  \n",
       "  \u001b[3mExample\u001b[0m: \u001b[1;36m100\u001b[0m–\u001b[1;36m115\u001b[0m lb \u001b[1m(\u001b[0mif 1RM OHP = \u001b[1;36m145\u001b[0m\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1;36m3\u001b[0m\u001b[1m)\u001b[0m \u001b[1mOne-arm DB row\u001b[0m \u001b[1m(\u001b[0mor seated cable row if low back prefers\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m\u001b[1m each side\u001b[0m @ RPE \u001b[1;36m8\u001b[0m | Rest \u001b[1;36m90\u001b[0m sec  \n",
       "  \u001b[3mLoad\u001b[0m: choose a DB that leaves ~\u001b[1;36m1\u001b[0m–\u001b[1;36m2\u001b[0m reps in reserve.\n",
       "\n",
       "\u001b[1;36m4\u001b[0m\u001b[1m)\u001b[0m \u001b[1mUnilateral leg work \u001b[0m\u001b[1m(\u001b[0m\u001b[1mchoose one\u001b[0m\u001b[1m)\u001b[0m  \n",
       "- \u001b[1mBulgarian split squat \u001b[0m\u001b[1m(\u001b[0m\u001b[1mDB\u001b[0m\u001b[1m)\u001b[0m or \u001b[1mLeg press \u001b[0m\u001b[1m(\u001b[0m\u001b[1msingle-leg or standard\u001b[0m\u001b[1m)\u001b[0m  \n",
       "  - Split squat: \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m\u001b[1m each leg\u001b[0m @ RPE \u001b[1;36m8\u001b[0m | Rest \u001b[1;36m90\u001b[0m sec  \n",
       "  - Leg press: \u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m10\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m15\u001b[0m @ RPE \u001b[1;36m8\u001b[0m | Rest \u001b[1;36m2\u001b[0m min  \n",
       "  \u001b[3mExample leg press\u001b[0m: \u001b[1;36m325\u001b[0m–\u001b[1;36m375\u001b[0m lb for sets of \u001b[1;36m10\u001b[0m–\u001b[1;36m15\u001b[0m \u001b[1m(\u001b[0mif 1RM leg press = \u001b[1;36m500\u001b[0m, ~\u001b[1;36m65\u001b[0m–\u001b[1;36m75\u001b[0m%\u001b[1m)\u001b[0m\n",
       "\n",
       "\u001b[1;36m5\u001b[0m\u001b[1m)\u001b[0m \u001b[1mIncline DB press\u001b[0m \u001b[1m(\u001b[0mor machine incline press\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m12\u001b[0m @ RPE \u001b[1;36m8\u001b[0m | Rest \u001b[1;36m90\u001b[0m sec  \n",
       "  \u001b[3mLoad\u001b[0m: pick DBs you can control without shoulder irritation.\n",
