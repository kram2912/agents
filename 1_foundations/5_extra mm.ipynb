       "<span style=\"color: #008080; text-decoration-color: #008080; font-weight: bold\">4</span><span style=\"font-weight: bold\">)</span> <span style=\"font-weight: bold\">Provider risk scoring</span> <span style=\"font-weight: bold\">(</span>repeatable savings<span style=\"font-weight: bold\">)</span>  \n",
