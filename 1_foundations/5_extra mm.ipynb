    "def create_todos(descriptions: list[str]) -> str:\n",
    "    todos.extend(descriptions) # Add the todo descripts to the list\n",
    "    completed.extend([False] * len(descriptions))  # add the equivalent number of Falses to match todos list\n",
    "    return get_todo_report()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "aa4d97e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def mark_complete(index: int, completion_notes: str) -> str:\n",
    "    if 1 <= index <= len(todos): # consider this an and statement\n",
    "        completed[index - 1] = True\n",
    "    else:\n",
    "        return \"No todo at this index.\"\n",
    "    Console().print(completion_notes)\n",
    "    return get_todo_report()"
   ]
