       "\u001b[1;36m6\u001b[0m\u001b[1m)\u001b[0m \u001b[1mHamstring curl machine\u001b[0m \u001b[1m(\u001b[0mseated preferred for many\u001b[1m)\u001b[0m  \n",
       "- \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m10\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m15\u001b[0m @ RPE \u001b[1;36m8\u001b[0m–\u001b[1;36m9\u001b[0m | Rest \u001b[1;36m60\u001b[0m–\u001b[1;36m90\u001b[0m sec\n",
       "\n",
       "\u001b[1;36m7\u001b[0m\u001b[1m)\u001b[0m \u001b[1mCable Pallof press\u001b[0m \u001b[1m(\u001b[0manti-rotation\u001b[1m)\u001b[0m or \u001b[1mloaded carry\u001b[0m  \n",
       "- Pallof: \u001b[1;36m2\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m10\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m15\u001b[0m\u001b[1m/side\u001b[0m \u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m-sec hold\u001b[1m)\u001b[0m | Rest \u001b[1;36m45\u001b[0m–\u001b[1;36m60\u001b[0m sec  \n",
       "- Farmer carry: \u001b[1;36m4\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m6\u001b[0m\u001b[1m x \u001b[0m\u001b[1;36m20\u001b[0m\u001b[1m–\u001b[0m\u001b[1;36m40\u001b[0m\u001b[1m m\u001b[0m with challenging DB/KBs | Rest \u001b[1;36m60\u001b[0m–\u001b[1;36m90\u001b[0m sec\n",
       "\n",
       "---\n",
       "\n",
       "\u001b[1;36m50\u001b[0m\u001b[1m+ execution notes \u001b[0m\u001b[1m(\u001b[0m\u001b[1mto keep results high and joints happy\u001b[0m\u001b[1m)\u001b[0m\n",
       "- Prioritize \u001b[1mcontrolled eccentrics\u001b[0m \u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m–\u001b[1;36m3\u001b[0m sec down\u001b[1m)\u001b[0m on most lifts; avoid grinders weekly.\n",
