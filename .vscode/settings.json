{
  "files.associations": {
    "*.py": "python"
  },
  "cursorpyright.analysis.exclude": [
    "**/.venv/**",
    "**/site-packages/**",
    "**/community_contributions/**",
    "**/node_modules/**"
  ],
  "cursorpyright.analysis.ignore": [
    "**/.venv/**",
    "**/site-packages/**",
    "**/community_contributions/**"
  ],
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/site-packages/**": true,
    "**/community_contributions/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/site-packages/**": true,
    "**/community_contributions/**": true
  }
}
